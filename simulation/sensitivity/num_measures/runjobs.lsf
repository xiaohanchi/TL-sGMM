cp main.R main_tmp${LSB_JOBINDEX}.R
perl -pi -e "s/rep00/${LSB_JOBINDEX}/g; s/seed00/1233${LSB_JOBINDEX}/g" main_tmp${LSB_JOBINDEX}.R
Rscript main_tmp${LSB_JOBINDEX}.R

rm main_tmp${LSB_JOBINDEX}.R
